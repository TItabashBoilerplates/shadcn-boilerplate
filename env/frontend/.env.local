TZ=Asia/Tokyo

# Supabase Configuration
# Next.js uses NEXT_PUBLIC_ prefix, Expo uses EXPO_PUBLIC_ prefix
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_ACJWlzQHlZjBrEguHvfOxg_3BJgxAaH
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_ACJWlzQHlZjBrEguHvfOxg_3BJgxAaH
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321

# Backend API URL
NEXT_PUBLIC_BACKEND_PY_URL="http://127.0.0.1:4040"
EXPO_PUBLIC_BACKEND_PY_URL="http://127.0.0.1:4040"

# App public URL (metadataBase / sitemap / robots / manifest / OG)
# 本番は Vercel の公開ドメインを Doppler/Vercel env で上書きする
NEXT_PUBLIC_APP_URL=http://localhost:3000

# OneSignal Push Notifications
# Get your App ID from https://app.onesignal.com/
NEXT_PUBLIC_ONE_SIGNAL_APP_ID=
EXPO_PUBLIC_ONE_SIGNAL_APP_ID=

# PostHog Analytics
# プロジェクト API キーはクライアント公開前提の非機密トークン。
# ローカルは空=計測無効（disabled）。リモート(dev/stg/prd)の値は Doppler で管理する。
# US Cloud は us.i.posthog.com / EU Cloud は eu.i.posthog.com（rewrites も合わせて変更）。
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
EXPO_PUBLIC_POSTHOG_KEY=
EXPO_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Logging Configuration
LOG_LEVEL=debug
NEXT_PUBLIC_LOG_LEVEL=debug
