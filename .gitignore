# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# =============================================================================
# Dependencies
# =============================================================================
node_modules/
.pnpm-store/

# Python virtual environments
.venv/
venv/

# Environment files
.env
.env.*
!.env.example

# Environment files directory
# commit するのは 非機密の .env.local / README のみ。
# シークレット・リモートの値はすべて Doppler 管理（ファイルに置かない）。
# その他の env/**（.env.<dev|staging|production> 等）は gitignore。
env/**
!env/*/
!env/**/.env.local
!env/README.md

# =============================================================================
# Build Outputs
# =============================================================================
# Frontend builds
**/dist/
**/build/
**/.next/**
**/.vercel/

# Expo
.expo/
**/web-build/

# Python builds
**/*.egg-info/

# =============================================================================
# Caches & Temporary Files
# =============================================================================
# Build tool caches
**/.turbo/**
**/*.tsbuildinfo

# Linter & Formatter caches
**.eslintcache

# Python tool caches
**/__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Test coverage
.coverage
**.coverage.*

# E2E test results (Maestro)
e2e-results/maestro/
htmlcov/

# Metro
**.metro-health-check*

# =============================================================================
# Logs
# =============================================================================
**/*.log
npm-debug.*
yarn-debug.*
yarn-error.*
**/*.pnpm-debug.log*
**/*.lerna-debug.log*

# =============================================================================
# IDE & Editor
# =============================================================================
# VS Code user-specific files (exclude)
.vscode/*
# But include recommended settings (include)
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/tasks.json
!.vscode/launch.json

.idea/
**/*.swp
**/*.scripts.swo
*~

# =============================================================================
# OS Files
# =============================================================================
# macOS
.DS_Store
*.pem

# Windows
Thumbs.db

# =============================================================================
# Native App Certificates & Keys
# =============================================================================
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# =============================================================================
# Project Specific
# =============================================================================
# AI services
ai/ollama/**
ai/ollama-webui/**

# Blockchain
blockchain/chainlink/postgres/data/**
blockchain/chainlink/data/**
blockchain/src/scripts/.wallets/**
ipfs/data/**
ipfs/contents/**
!.gitkeep

# Supabase
supabase/.branches/**
supabase/.temp/**

# Playwright MCP
.playwright-mcp/**

# Codex CLI local settings (config.toml.example is tracked)
.codex/config.toml

.serena/**

# devenv
.devenv/
.devenv.flake.nix
devenv.local.nix
devenv.local.yaml
.direnv/
.pre-commit-config.yaml

# devenv android profile (`-P android`) が enterShell で CWD に生成する。
# 中身は /nix/store の SDK/NDK パスなので環境依存 = コミットしない。
/local.properties
/.android/

# CCR web-sandbox E2E artifacts

# Storybook static build output (`build-storybook`)
storybook-static/

# ストア掲載用スクリーンショット（screenshots-mobile が生成する成果物）
# 撮影→検証→アップロードを 1 回で回す前提なのでコミットしない。
# 手で差し替えた画像を残したい場合だけ、そのファイルを個別に -f で追加する。
e2e-results/store-screenshots/
# ストア掲載用スクリーンショット（撮影 → 検証 → 反映を 1 回で回す前提の生成物）。
# フィーチャーグラフィックは設計素材なのでコミットする（assets/store/ 配下）。
store-listing/
