				}
			},
			"boundaries/include": ["src/**/*", "app/**/*"],
			"boundaries/elements": [
				{
					"type": "nextjs-app",
					"pattern": "app/**/*",
					"partialMatch": false
				},
				{
					"type": "fsd-app",
					"pattern": "src/app/**/*",
					"partialMatch": false
				},
				{
					"type": "views",
					"pattern": "src/views/*",
					"capture": ["slice"]
				},
				{
					"type": "widgets",
					"pattern": "src/widgets/*",
					"capture": ["slice"]
				},
				{
					"type": "features-cross-import",
					"pattern": "src/features/*/@x/*",
					"partialMatch": false,
					"capture": ["sourceSlice", "targetSlice"]
				},
				{
					"type": "features",
					"pattern": "src/features/*",
					"capture": ["slice"]
				},
				{
					"type": "entities-cross-import",
					"pattern": "src/entities/*/@x/*",
					"partialMatch": false,
					"capture": ["sourceSlice", "targetSlice"]
				},
				{
					"type": "entities",
					"pattern": "src/entities/*",
					"capture": ["slice"]
				},
				{
					"type": "shared",
					"pattern": "src/shared/*",
					"capture": ["segment"]
				},
				{
					"type": "workspace",
					"pattern": "@workspace/**"
				}
			]
		}
