			"import/resolver": {
				"/Volumes/External/Development/orca/worktrees/shadcn-boilerplate/nerite/frontend/node_modules/eslint-import-resolver-node/index.js": {
					"extensions": [".js", ".jsx", ".ts", ".tsx"]
				},
