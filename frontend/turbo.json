{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "agentGuidance": false,
  "tasks": {
    "generate": {
      "cache": false,
      "outputs": ["src/generated/**"]
    },
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*", "!**/.env*.local"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**", ".expo/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "start": {
      "cache": false,
      "persistent": true
    },
    "ios": {
      "cache": false,
      "persistent": true
    },
    "android": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^lint"],
      "env": ["TURBO_LINT_POLICY_HASH"],
      "inputs": ["$TURBO_DEFAULT$", "eslint.config.*"]
    },
    "type-check": {
      "dependsOn": ["transit"],
      "outputs": []
    },
    "transit": {
      "dependsOn": ["^transit"]
    },
    "format": {
      "outputs": [],
      "cache": false
    },
    "format-check": {
      "outputs": [],
      "cache": false
    },
    "clean": {
      "cache": false
    },
    "storybook": {
      "cache": false,
      "persistent": true
    },
    "//#storybook:build": {
      "dependsOn": ["@workspace/tokens#build"],
      "outputs": ["storybook-static/**"]
    },
    "lint:ci": {
      "env": ["TURBO_LINT_POLICY_HASH"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/../.oxlintrc.json",
        "$TURBO_ROOT$/tooling/eslint/**"
      ]
    }
  },
  "globalEnv": [
    "NEXT_PUBLIC_SUPABASE_URL",
    "NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY",
    "NEXT_PUBLIC_BACKEND_PY_URL",
    "EXPO_PUBLIC_SUPABASE_URL",
    "EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY",
    "BACKEND_URL",
    "TURBO_TOOLCHAIN_HASH"
  ],
  "boundaries": {
    "tags": {
      "app": {
        "dependencies": {
          "allow": ["app", "ui-pkg", "infra-pkg", "tool-pkg"]
        }
      },
      "ui-pkg": {
        "dependencies": {
          "allow": ["ui-pkg", "infra-pkg", "tool-pkg"]
        }
      },
      "infra-pkg": {
        "dependencies": {
          "allow": ["infra-pkg", "tool-pkg"]
        }
      },
      "tool-pkg": {
        "dependencies": {
          "allow": ["tool-pkg"]
        }
      }
    }
  }
}
