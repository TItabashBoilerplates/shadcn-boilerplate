{
  "name": "@repo/frontend-monorepo",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*",
    "packages/client/*",
    "tooling/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "start": "turbo run start",
    "lint": "turbo run lint && oxlint --fix policy scripts .storybook && biome lint --write .",
    "lint:ci": "turbo run lint:ci && oxlint policy scripts .storybook && biome lint .",
    "format": "biome check --linter-enabled=false --write .",
    "format-check": "biome check --linter-enabled=false .",
    "type-check": "turbo run type-check",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "turbo clean && rm -rf node_modules",
    "ui:add:web": "cd packages/ui && bunx shadcn@latest add",
    "ui:add:mobile": "cd packages/native-ui && bunx gluestack-ui@latest add --use-bun",
    "tokens:build": "bun run packages/tokens/scripts/generate-css.ts",
    "generate:types": "bun run scripts/generate-types.ts",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "turbo run storybook:build",
    "storybook:build": "storybook build"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.5.0",
    "@supabase/supabase-js": "^2.117.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.56.0",
    "motion": "^14.2.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "tailwind-merge": "^3.7.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@next/eslint-plugin-next": "16.4.2",
    "@storybook/addon-docs": "10.6.2",
    "@storybook/addon-themes": "10.6.2",
    "@storybook/react": "10.6.2",
    "@storybook/react-native-web-vite": "10.6.2",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/react": "^16.3.3",
    "@turbo/gen": "^2.11.7",
    "@types/node": "^24.19.2",
    "@types/react": "~19.2.18",
    "@types/react-dom": "~19.2.7",
    "@vitejs/plugin-react": "^6.1.2",
    "@workspace/tsc": "workspace:*",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-expo": "1.1.0",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "jsdom": "^30.1.2",
    "oxlint": "1.91.0",
    "playwright-core": "1.64.0",
    "react-native-web": "~0.21.4",
    "storybook": "10.6.2",
    "tailwindcss": "^4.3.3",
    "tsrs": "0.22.0-ts7.1.0-beta",
    "turbo": "^2.11.7",
    "tw-animate-css": "^1.4.0",
    "typescript": "6.0.3",
    "vite": "8.3.4",
    "vitest": "^5.0.4"
  },
  "overrides": {
    "glob": "14.0.4",
    "minimatch@^10": "11.0.5",
    "node-forge": "1.4.3",
    "query-string>decode-uri-component": "0.5.1",
    "nativewind": "5.0.0-rc.0",
    "react-native-css": "3.1.0-rc.0",
    "lightningcss": "1.30.1",
    "handlebars": "4.7.10",
    "js-yaml": "4.3.2"
  },
  "engines": {
    "node": "^24.22.1",
    "bun": ">=1.4.4"
  },
  "packageManager": "bun@1.4.4",
  "patchedDependencies": {
    "decode-uri-component@0.5.1": "patches/decode-uri-component@0.5.1.patch"
  }
}
