{
  "name": "@repo/frontend-monorepo",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*",
    "packages/client/*",
    "tooling/*"
  ],
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "start": "turbo start",
    "lint": "biome check --write .",
    "lint:ci": "biome ci .",
    "format": "biome format --write .",
    "format-check": "biome format .",
    "type-check": "turbo type-check",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "turbo clean && rm -rf node_modules",
    "ui:add:web": "cd packages/ui && bunx shadcn@latest add",
    "ui:add:mobile": "cd packages/native-ui && bunx gluestack-ui@latest add --use-bun",
    "tokens:build": "bun run packages/tokens/scripts/generate-css.ts",
    "generate:types": "bun run scripts/generate-types.ts",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.5.0",
    "@supabase/supabase-js": "^2.117.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.56.0",
    "motion": "^14.2.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "tailwind-merge": "^3.7.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@storybook/addon-docs": "10.6.2",
    "@storybook/addon-themes": "10.6.2",
    "@storybook/react": "10.6.2",
    "@storybook/react-native-web-vite": "10.6.2",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/react": "^16.3.3",
    "@turbo/gen": "^2.11.7",
    "@types/node": "^24.19.2",
    "@types/react": "~19.2.18",
    "@types/react-dom": "~19.2.7",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitejs/plugin-react": "^6.1.2",
    "@workspace/tsc": "workspace:*",
    "jsdom": "^30.1.2",
    "playwright-core": "1.64.0",
    "react-native-web": "~0.21.4",
    "storybook": "10.6.2",
    "tailwindcss": "^4.3.3",
    "turbo": "^2.11.7",
    "tw-animate-css": "^1.4.0",
    "typescript": "6.0.3",
    "vite": "8.3.4",
    "vitest": "^5.0.4"
  },
  "overrides": {
    "nativewind": "5.0.0-rc.0",
    "react-native-css": "3.1.0-rc.0",
    "lightningcss": "1.30.1"
  },
  "engines": {
    "node": ">=22.18.0",
    "bun": ">=1.2.0"
  },
  "packageManager": "bun@1.4.2"
}
