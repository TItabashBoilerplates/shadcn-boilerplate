{
  "name": "@repo/frontend-monorepo",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*",
    "packages/client/*",
    "tooling/*"
  ],
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "start": "turbo start",
    "lint": "biome check --write .",
    "lint:ci": "biome ci .",
    "format": "biome format --write .",
    "format-check": "biome format .",
    "type-check": "turbo type-check",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "turbo clean && rm -rf node_modules",
    "ui:add:web": "cd packages/ui && bunx shadcn@latest add",
    "ui:add:mobile": "cd packages/native-ui && bunx gluestack-ui@latest add --use-bun",
    "tokens:build": "bun run packages/tokens/scripts/generate-css.ts",
    "generate:types": "bun run scripts/generate-types.ts",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.3.3",
    "@supabase/supabase-js": "^2.112.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.28.0",
    "motion": "^13.0.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "tailwind-merge": "^3.6.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.11",
    "@storybook/addon-docs": "10.5.7",
    "@storybook/addon-themes": "10.5.7",
    "@storybook/react": "10.5.7",
    "@storybook/react-native-web-vite": "10.5.7",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/react": "^16.3.2",
    "@turbo/gen": "^2.10.8",
    "@types/node": "^24.9.1",
    "@types/react": "^19.2.4",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.4",
    "jsdom": "^27.4.0",
    "playwright-core": "1.56.0",
    "react-native-web": "^0.21.2",
    "storybook": "10.5.7",
    "tailwindcss": "^4.3.3",
    "turbo": "^2.10.8",
    "tw-animate-css": "^1.4.0",
    "typescript": "~6.0.3",
    "vite": "7.3.1",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "nativewind": "5.0.0-preview.4",
    "react-native-css": "^3.0.7",
    "lightningcss": "1.30.1"
  },
  "engines": {
    "node": ">=20.19.0",
    "bun": ">=1.2.0"
  },
  "packageManager": "bun@1.2.8"
}
