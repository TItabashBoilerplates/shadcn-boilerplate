{
  "cli": {
    "version": ">= 16.0.1",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "node": "24.22.1",
      "bun": "1.4.4",
      "developmentClient": true,
      "distribution": "internal",
      "autoIncrement": true,
      "channel": "development",
      "environment": "development",
      "android": {
        "buildType": "apk"
      }
    },
    "development-simulator": {
      "extends": "development",
      "channel": "development-simulator",
      "ios": {
        "simulator": true
      }
    },
    "preview": {
      "node": "24.22.1",
      "bun": "1.4.4",
      "distribution": "internal",
      "autoIncrement": true,
      "channel": "preview",
      "environment": "preview",
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "node": "24.22.1",
      "bun": "1.4.4",
      "autoIncrement": true,
      "channel": "production",
      "environment": "production"
    }
  },
  "submit": {
    "production": {
      "ios": {},
      "android": {
        "serviceAccountKeyPath": "./credentials/play-sa.json",
        "track": "internal",
        "releaseStatus": "draft"
      }
    }
  }
}
