{
  "name": "@workspace/mobile",
  "main": "expo-router/entry",
  "version": "0.1.0",
  "scripts": {
    "start": "expo start",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "oxlint --deny-warnings --no-error-on-unmatched-pattern -c oxlint.config.mjs . --fix && eslint --no-config-lookup -c ../../tooling/eslint/compat.mjs src --max-warnings 0",
    "lint:fsd": "oxlint --deny-warnings --no-error-on-unmatched-pattern -c oxlint.config.mjs . && eslint --no-config-lookup -c ../../tooling/eslint/compat.mjs src --max-warnings 0",
    "type-check": "workspace-tsc --noEmit",
    "lint:ci": "oxlint --deny-warnings --no-error-on-unmatched-pattern -c oxlint.config.mjs . && eslint --no-config-lookup -c ../../tooling/eslint/compat.mjs src --max-warnings 0"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/native": "^7.5.1",
    "@supabase/supabase-js": "^2.119.0",
    "@workspace/app": "workspace:*",
    "@workspace/auth": "workspace:*",
    "@workspace/client-supabase": "workspace:*",
    "@workspace/native-ui": "workspace:*",
    "@workspace/tokens": "workspace:*",
    "expo": "^58.0.23",
    "expo-application": "~58.1.2",
    "expo-constants": "~58.0.15",
    "expo-font": "~58.0.12",
    "expo-haptics": "~58.0.8",
    "expo-image": "~58.0.18",
    "expo-linking": "~58.0.16",
    "expo-localization": "~58.0.5",
    "expo-router": "~58.0.30",
    "expo-splash-screen": "~58.0.13",
    "expo-status-bar": "~58.0.5",
    "expo-symbols": "~58.0.5",
    "expo-system-ui": "~58.0.7",
    "expo-updates": "~58.0.21",
    "expo-web-browser": "~58.0.8",
    "i18n-js": "^4.5.4",
    "nativewind": "5.0.0-rc.0",
    "posthog-react-native": "^4.86.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-css": "3.1.0-rc.0",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-onesignal": "^5.5.17",
