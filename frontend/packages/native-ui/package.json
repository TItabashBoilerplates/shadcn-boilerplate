{
  "name": "@workspace/native-ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./components/index.ts",
    "./components": "./components/index.ts",
    "./components/*": "./components/*",
    "./layout": "./layout/index.ts",
    "./layout/*": "./layout/*.tsx",
    "./hooks": "./hooks/index.ts",
    "./hooks/*": "./hooks/*.ts",
    "./constants": "./constants/index.ts",
    "./constants/*": "./constants/*.ts"
  },
  "scripts": {
    "type-check": "workspace-tsc --noEmit",
    "lint:ci": "oxlint --no-error-on-unmatched-pattern .",
    "lint": "oxlint --no-error-on-unmatched-pattern --fix ."
  },
  "dependencies": {
    "@expo/vector-icons": "^15.1.1",
    "@gluestack-ui/core": "^5.0.15",
    "@gluestack-ui/utils": "^5.0.6",
    "@react-navigation/native": "^7.5.1",
    "@workspace/tokens": "workspace:*",
    "expo-symbols": "~58.0.5",
    "nativewind": "5.0.0-rc.0",
    "react-native-css": "3.1.0-rc.0",
    "react-native-reanimated": "4.7.1"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "@workspace/tsc": "workspace:*",
    "react": "19.3.1",
    "react-native": "0.88.1"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-native": ">=0.86.0",
    "react-native-safe-area-context": ">=5.0.0",
    "react-native-svg": ">=15.0.0"
  }
}
