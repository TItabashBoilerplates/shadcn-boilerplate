# Build stage
FROM python:3.13-slim-bookworm AS builder
COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /bin/

WORKDIR /service

# Install build dependencies
RUN apt-get update && apt-get install -y \
    gcc \
    g++ \
    make \
    curl \
    libedit2 \
    libopus-dev \
    libvpx-dev \
    python3-dev \
    rustc \
    cargo \
    --no-install-recommends && \
    rm -rf /var/lib/apt/lists/*

# Copy dependency files first (cache layer)
COPY ./backend-py/app/pyproject.toml ./backend-py/app/uv.lock /service/

ENV RUSTFLAGS="-C target-feature=-crt-static"

# Install dependencies (cached layer)
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --frozen --no-dev

# Copy application code
COPY ./backend-py/app /service/app

# Production stage
FROM python:3.13-slim-bookworm

WORKDIR /service

# Copy only necessary files from builder
COPY --from=builder /service/.venv /service/.venv
COPY --from=builder /service/app /service/app

# Set environment variables
ENV PYTHONUNBUFFERED=1
ENV PATH="/service/.venv/bin:$PATH"
ENV PYTHONPATH="/service/app/src:$PYTHONPATH"

# Expose port
EXPOSE 8000

# Set user
RUN useradd -m -s /bin/bash appuser && \
    chown -R appuser:appuser /service
USER appuser

# Railway provides PORT dynamically; default to 8000
CMD ["sh", "-c", ". .venv/bin/activate && cd app/src && uvicorn app:app --host 0.0.0.0 --port ${PORT:-8000}"]
