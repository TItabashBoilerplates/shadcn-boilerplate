# syntax=docker/dockerfile:1
#
# Vercel 用 Dockerfile（uv workspace の apps/api = FastAPI サーバ **1 アプリ 1 コンテナ**）。
#
# モノレポ構成: backend-py は uv workspace（apps/api, apps/mcp, packages/core）。
# アプリごとに `apps/<app>/Dockerfile.vercel` を置き、`backend-py/vercel.json` の `services`
# から entrypoint として参照する（Vercel が service ごとに別コンテナをビルドする。
# https://vercel.com/docs/functions/container-images）。
#
#   - **ビルドコンテキストは workspace ルート（backend-py/）**。Vercel project の Root Directory を
#     `backend-py` にし、`vercel.json` の `services.api.entrypoint = "apps/api/Dockerfile.vercel"` で
#     この Dockerfile を指す。コンテキストが workspace ルートなので `uv.lock` / `packages/core` /
#     他 member の pyproject を解決できる（この Dockerfile 内のパスはすべてコンテキスト基準）。
#   - サーバは `$PORT` で listen する必要がある。api.main が $PORT を読む。
#     **本リポジトリは 8080（非特権ポート）で固定する**。Vercel の既定は 80 だが、この
#     コンテナは非 root で動くため 80 を bind できない（下の「⚠️ 無言で壊れる 2 点」）。
#   - scale-in 時は SIGTERM + 30s grace。uvicorn が SIGTERM で graceful shutdown する。
#
# ── ⚠️ Vercel 上でだけ無言で壊れる 2 点（どちらもローカルでは絶対に再現しない）────────
# ビルドは成功し、型もリントもテストも通り、`docker run` もローカルでは動くのに、
# **Vercel 上でだけ 500（INTERNAL_FUNCTION_INVOCATION_FAILED）になり、アプリのログが
# 1 行も出ない**。この 2 点は必ず守ること（`apps/api/tests/test_vercel_container_contract.py`
# が CI で検査している）。
#
#   ① 非 root（USER appuser）で特権ポート（< 1024）は bind できない
#        ERROR: [Errno 13] error while attempting to bind on address ('0.0.0.0', 80):
#        permission denied
#      → `ENV PORT=8080`。**Vercel project の環境変数 `PORT` も 8080 に揃える**
#        （揃えないと Vercel は 80 へ流し、コンテナは 8080 で待つ）。
#        provisioning は scripts/infra/vercel.sh が自動で入れる。
#      ※ ローカルの Docker は既定で特権ポートを許可するため、手元では再現しない。
#
#   ② CMD が $PATH 解決に依存していると exec に失敗する
#        exec: "api": executable file not found in $PATH
#      Vercel はコンテナ起動時に自前の wrapper を挟むため、**イメージの `ENV PATH`
#      （ここでは /app/.venv/bin を足したもの）が起動プロセスに反映されないことがある**
#      （公式には文書化されていない挙動。実測で確認）。exec に失敗したプロセスはログを
#      1 行も出さずに死ぬので、ランタイムログを見ても原因が分からない。
#      → `CMD` は**必ず絶対パス**で書く（`["/app/.venv/bin/api"]`）。
#
# Vercel 相当の条件はローカルで作れる。この Dockerfile を変えたら必ず通すこと:
#
#   docker build -f apps/api/Dockerfile.vercel -t api-vercel .    # context = backend-py
#   docker run --rm -p 8080:8080 \
#     -e PATH=/usr/local/bin:/usr/local/sbin:/usr/sbin:/usr/bin:/sbin:/bin \
#     --sysctl net.ipv4.ip_unprivileged_port_start=1024 \
#     api-vercel
#   curl -fsS localhost:8080/healthcheck   # → {"message":"OK"}
#
# 詳細・切り分け手順（ランタイムログの取り方を含む）:
#   .claude/skills/vercel-deploy/references/containers.md
#
# 別アプリを足すときは `apps/<app>/Dockerfile.vercel` を作り、`vercel.json` に service + rewrite を
# 追加する（詳細は docs/deployment/README.md / backend-py/README.md）。
#
# ── devenv とローカル/本番の環境を揃えるための工夫 ──────────────────────────────
# ローカルは devenv（devenv.nix）が Nix で環境を作り、本番はこの Dockerfile。両者を drift させない
# ため、以下を「同じ事実」に固定している:
#   1. Python 3.13     : ARG PYTHON_VERSION=3.13 = devenv の languages.python(pkgs.python313) = .python-version。
#   2. uv              : devenv の languages.python.uv.enable と同じ uv を使う（pip で入れない）。
#   3. **同一 uv.lock**: `uv sync --frozen` で lockfile を厳守 → devenv の `uv sync` と **完全に同じ解決結果**
#                        （依存バージョンが本番とローカルで一致する。ここが最重要の整合ポイント）。
#   4. Python 追加DL無 : UV_PYTHON_DOWNLOADS=0 = devenv がベースイメージ/Nix の python を使うのと同じ思想。
#   5. 起動            : uvicorn api.app:app --proxy-headers（api.main） = devenv の backendExec の起動と同一
#                        （本番は --reload 無し・$PORT のみ差分）。
#   6. env             : PYTHONDONTWRITEBYTECODE=1 = env/backend/.env.local と一致。
#   7. system libs     : devenv の packages(gcc/gnumake/libedit/libopus/libvpx) のうち、ビルドに要る gcc/make は
#                        builder の build-essential で用意。libopus/libvpx（音声・映像=将来の LiveKit/PyAV 用）は
#                        現状の依存では不要なので final には入れず、導入時に足す（下の final stage コメント参照）。
# uv 公式 Docker ベストプラクティス（multi-stage / cache mount / --no-editable）に準拠。

ARG PYTHON_VERSION=3.13

# ---------- builder: uv workspace を /app/.venv に解決・インストール ----------
FROM python:${PYTHON_VERSION}-slim AS builder

# 公式イメージから uv バイナリだけ持ち込む（pip で uv を入れない）
COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /bin/

# 本番最適化: bytecode プリコンパイル / copy link mode（bind mount 跨ぎで安全） /
# コンテナ内で Python を追加ダウンロードしない（base image の python を使う）
ENV UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_PYTHON_DOWNLOADS=0

WORKDIR /app

# wheel の無い sdist をビルドするための保険（final stage には持ち込まない）
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt,sharing=locked \
    apt-get update && apt-get install -y --no-install-recommends build-essential

# 1) 依存だけ先に解決（プロジェクト本体は含めない）。
#    依存は安定・本体は頻繁に変わるので層を分けてキャッシュ効率を最大化する。
#    workspace の全 member の pyproject を bind mount する（uv がグラフを解決するのに必要）。
#    ※ パスはすべてビルドコンテキスト（= workspace ルート backend-py/）基準。
RUN --mount=type=cache,target=/root/.cache/uv \
    --mount=type=bind,source=uv.lock,target=uv.lock \
    --mount=type=bind,source=pyproject.toml,target=pyproject.toml \
    --mount=type=bind,source=apps/api/pyproject.toml,target=apps/api/pyproject.toml \
    --mount=type=bind,source=apps/mcp/pyproject.toml,target=apps/mcp/pyproject.toml \
    --mount=type=bind,source=packages/core/pyproject.toml,target=packages/core/pyproject.toml \
    uv sync --frozen --no-dev --no-install-workspace

# 2) ソースを入れて api service（+ workspace dep の core）だけ non-editable でインストール。
#    --package api で api とその依存のみに絞る。--no-editable で site-packages にコピーされるため
#    final stage は .venv だけで完結する（他アプリ apps/mcp は含めない = アプリ単位の分離）。
COPY . /app
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --frozen --no-dev --no-editable --package api

# ---------- final: slim ランタイム。venv だけコピー ----------
FROM python:${PYTHON_VERSION}-slim AS final

# 現状の依存（fastapi / uvicorn[standard] / psycopg2-binary / supabase 等）はすべて
# manylinux wheel で完結し、追加の共有ライブラリは不要。
# LiveKit / PyAV 等の音声・映像系（devenv の libopus / libvpx）を導入した際は、
# ここに runtime 共有ライブラリ（例: libopus0 / libvpx*）を追記すること。

# PATH は `docker exec` などで人が使うための利便。**起動の解決には使わない**（②）。
# PORT=8080: 非 root で bind できる非特権ポート（①）。Vercel project の env と揃える。
ENV PATH="/app/.venv/bin:$PATH" \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PORT=8080

COPY --from=builder /app/.venv /app/.venv

# 非 root 実行（uid 10001）。この USER のせいで特権ポートを bind できない → PORT=8080（①）
RUN useradd --create-home --uid 10001 appuser
USER appuser

EXPOSE 8080

# [project.scripts] api = "api.main:main"。main() が $PORT を読んで uvicorn を起動する。
# **絶対パスで書く**（②。`CMD ["api"]` は Vercel 上で exec に失敗する）。
CMD ["/app/.venv/bin/api"]
