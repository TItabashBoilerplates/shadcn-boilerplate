# syntax=docker/dockerfile:1
#
# Vercel Services のコンテナサービス（uv workspace の apps/api = FastAPI サーバ）。
#
# ── 置き場所とファイル名は自由に選べない（ここを外すと無言で壊れる）────────────────
# Vercel の実装（`vercel/vercel`）で 2 つの制約が確定している:
#
#   packages/fs-detectors/src/services/resolve-v2.ts
#     const CONTAINER_ENTRYPOINT_CANDIDATES = [
#       'Dockerfile.vercel', 'Containerfile.vercel', 'Dockerfile', 'Containerfile',
#     ];
#     → entrypoint の basename はこの 4 つだけ。`Dockerfile.api.vercel` のような
#       接尾辞つきの名前は "never matched"（コメントに明記）。
#
#   packages/container/src/index.ts
#     const contextDir = path.dirname(dockerfilePath);
#     → **ビルドコンテキストは常に Dockerfile のあるディレクトリ**。`services.<name>.root`
#       でも Root Directory でも `.vercelignore` でも変えられない（上書き手段が無い）。
#
# 一方 uv 公式は workspace のビルドについて「`uv.lock` が最新かどうかは **全 member の
# pyproject.toml が無いと検証できない**」と明記している（https://docs.astral.sh/uv/guides/integration/docker/）。
# つまりコンテキスト = workspace ルートが必須。両者を満たす置き方は 1 つしかない:
# **この Dockerfile を workspace ルート（backend-py/）に、blessed 名で置く。**
#
#   "services": { "api": { "runtime": "container", "root": ".", "entrypoint": "Dockerfile.vercel" } }
#
# Vercel project の Root Directory は `backend-py`。したがってコンテキスト = backend-py/ となり、
# 以下の COPY / bind mount のパスはすべて backend-py/ 基準で書いてある。
#
# ── モノレポで 2 つ目以降のアプリを出すときの名前の割り当て ─────────────────────
# blessed 名が 4 つあるので、**1 ディレクトリにつき最大 4 つのコンテナサービス**を置ける。
# 名前からアプリが読み取れないため、対応表をここと README と vercel.json のテストで固定する:
#
#   backend-py/Dockerfile.vercel      → service "api"   (apps/api / FastAPI)   ← このファイル
#   backend-py/Containerfile.vercel   → 2 つ目のアプリ（未使用）
#   backend-py/Dockerfile             → 3 つ目のアプリ（未使用）
#   backend-py/Containerfile          → 4 つ目のアプリ（未使用）
#
# 追加手順は backend-py/README.md「2 つ目のアプリをコンテナで出す」を参照。
# アプリごとに別イメージなので `uv sync --package <app>` の絞り込みが効き、
# 片方の重い依存（ffmpeg 等）がもう片方のイメージに入らない。
#
# ── ランタイムの前提 ────────────────────────────────────────────────────────
#   - サーバは `$PORT`（Vercel 既定 80）で listen する必要がある。api.main が $PORT を読む。
#   - scale-in 時は SIGTERM + 30s grace。uvicorn が SIGTERM で graceful shutdown する。
#
# ── devenv とローカル/本番の環境を揃えるための工夫 ──────────────────────────────
# ローカルは devenv（devenv.nix）が Nix で環境を作り、本番はこの Dockerfile。両者を drift させない
# ため、以下を「同じ事実」に固定している:
#   1. Python 3.13     : ARG PYTHON_VERSION=3.13 = devenv の languages.python(pkgs.python313) = .python-version。
#   2. uv              : devenv の languages.python.uv.enable と同じ uv を使う（pip で入れない）。
#   3. **同一 uv.lock**: `uv sync --frozen` で lockfile を厳守 → devenv の `uv sync` と **完全に同じ解決結果**
#                        （依存バージョンが本番とローカルで一致する。ここが最重要の整合ポイント）。
#   4. Python 追加DL無 : UV_PYTHON_DOWNLOADS=0 = devenv がベースイメージ/Nix の python を使うのと同じ思想。
#   5. 起動            : uvicorn api.app:app --proxy-headers（api.main） = devenv の backendExec の起動と同一
#                        （本番は --reload 無し・$PORT のみ差分）。
#   6. env             : PYTHONDONTWRITEBYTECODE=1 = env/backend/.env.local と一致。
#   7. system libs     : devenv の packages(gcc/gnumake/libedit/libopus/libvpx) のうち、ビルドに要る gcc/make は
#                        builder の build-essential で用意。libopus/libvpx（音声・映像=将来の LiveKit/PyAV 用）は
#                        現状の依存では不要なので final には入れず、導入時に足す（下の final stage コメント参照）。
# uv 公式 Docker ベストプラクティス（multi-stage / cache mount / --no-editable）に準拠。
ARG PYTHON_VERSION=3.13

# ---------- builder: uv workspace を /app/.venv に解決・インストール ----------
FROM python:${PYTHON_VERSION}-slim AS builder

# 公式イメージから uv バイナリだけ持ち込む（pip で uv を入れない）
COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /bin/

# 本番最適化: bytecode プリコンパイル / copy link mode（bind mount 跨ぎで安全） /
# コンテナ内で Python を追加ダウンロードしない（base image の python を使う）
ENV UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_PYTHON_DOWNLOADS=0

WORKDIR /app

# wheel の無い sdist をビルドするための保険（final stage には持ち込まない）
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt,sharing=locked \
    apt-get update && apt-get install -y --no-install-recommends build-essential

# 1) 依存だけ先に解決（プロジェクト本体は含めない）。
#    依存は安定・本体は頻繁に変わるので層を分けてキャッシュ効率を最大化する。
#    workspace の全 member の pyproject を bind mount する（uv がグラフを解決するのに必要）。
#    ※ パスはすべてビルドコンテキスト（= workspace ルート backend-py/）基準。
RUN --mount=type=cache,target=/root/.cache/uv \
    --mount=type=bind,source=uv.lock,target=uv.lock \
    --mount=type=bind,source=pyproject.toml,target=pyproject.toml \
    --mount=type=bind,source=apps/api/pyproject.toml,target=apps/api/pyproject.toml \
    --mount=type=bind,source=apps/mcp/pyproject.toml,target=apps/mcp/pyproject.toml \
    --mount=type=bind,source=packages/core/pyproject.toml,target=packages/core/pyproject.toml \
    uv sync --frozen --no-dev --no-install-workspace

# 2) ソースを入れて api service（+ workspace dep の core）だけ non-editable でインストール。
#    --package api で api とその依存のみに絞る。--no-editable で site-packages にコピーされるため
#    final stage は .venv だけで完結する（他アプリ apps/mcp は含めない = アプリ単位の分離）。
#    ここは全 member が揃っているので **--locked**（uv 公式: 1 回目は --frozen、
#    「The next sync, after all the workspace members have been copied, can still use --locked
#    and will validate that the lockfile is correct for all workspace members.」）。
#    lockfile が古いまま本番へ出るのをビルド時に落とせる。
COPY . /app
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --locked --no-dev --no-editable --package api

# ---------- final: slim ランタイム。venv だけコピー ----------
FROM python:${PYTHON_VERSION}-slim AS final

# 現状の依存（fastapi / uvicorn[standard] / psycopg2-binary / supabase 等）はすべて
# manylinux wheel で完結し、追加の共有ライブラリは不要。
# LiveKit / PyAV 等の音声・映像系（devenv の libopus / libvpx）を導入した際は、
# ここに runtime 共有ライブラリ（例: libopus0 / libvpx*）を追記すること。

ENV PATH="/app/.venv/bin:$PATH" \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PORT=80

COPY --from=builder /app/.venv /app/.venv

# 非 root 実行
RUN useradd --create-home --uid 10001 appuser
USER appuser

EXPOSE 80

# [project.scripts] api = "api.main:main"。main() が $PORT を読んで uvicorn を起動する。
CMD ["api"]
