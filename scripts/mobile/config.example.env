# scripts/mobile/* の非機密入力テンプレート。
#   cp scripts/mobile/config.example.env scripts/mobile/config.env
# として値を埋める（config.env は .gitignore 対象）。
#
# ⚠️ ここには「非機密値」だけを置く。トークン・API キー・サービスアカウント鍵は
#    一切書かない（それらは Doppler から `doppler run` で注入される）。
#    詳細は .claude/rules/mcp-doppler.md / .claude/skills/mobile-release/SKILL.md を参照。

# ── アプリ ────────────────────────────────────────────────────────────────
# モバイルアプリのパス（リポジトリルートからの相対）
MOBILE_APP_DIR="frontend/apps/mobile"

# 使う eas-cli。既定は最新。ビルドを固定したいときだけ eas-cli@<major> のように固定する。
EAS_CLI_SPEC="eas-cli@latest"

# 既定のビルド/提出プロファイル（eas.json の build.* / submit.* のキー名）
EAS_PROFILE="production"

# ── App Store Connect ────────────────────────────────────────────────────
# ASC の App ID（App Store の URL apps.apple.com/app/id<この数字> に出る**公開値**）。
# シークレットではないが、アプリ固有なので Doppler ではなくここに置く。
# App Store Connect でアプリレコードを作成すると採番される。未設定だと
# `No suitable application records found` でアップロードが落ちる。
APPLE_ASC_APP_ID=""

# 提出経路: eas（既定・OS 非依存） / altool（macOS + Xcode 専用。EAS の submit キューを迂回）
IOS_SUBMIT_VIA="eas"

# ── Doppler のレイアウト ─────────────────────────────────────────────────
# 既定（空）では doppler.yaml でローカル紐付けした project の dev/stg/prd を使う。
# EXPO_TOKEN / APPLE_* / PLAY_SERVICE_ACCOUNT_JSON のような**アカウント共通のトークン**を
# 別 project にまとめている場合だけ、ここを埋める（2 段の doppler run で両方を注入する）。
MOBILE_TOKENS_PROJECT=""
MOBILE_TOKENS_CONFIG="prd"

# ── ストア掲載用スクリーンショット（screenshots-mobile）────────────────────
# 撮影に使う iOS simulator。**ストア必須サイズちょうどの実ピクセルが出る機種**を選ぶこと。
#   iPhone 16 Pro Max     : 440x956 pt  @3x = 1320x2868 → App Store 6.9"（必須サイズ）
#   iPad Pro 13-inch (M4) : 1032x1376 pt @2x = 2064x2752 → App Store 13"
# 複数撮る場合は改行区切りで並べる。機種を変えるとピクセルが変わり検証で落ちるので、
# 変更時は scripts/mobile/validate-screenshots.mjs の APP_STORE_SIZES と突き合わせる。
IOS_SCREENSHOT_DEVICES="iPhone 16 Pro Max"

# 撮影に使う Android AVD 名。
# ⚠️ Play は「最大辺 ≤ 最小辺 x2」を要求する。最近の既定プロファイル（Pixel 7 = 1080x2400）は
#    2.22 倍で **違反する**ため、1080x1920 (16:9) の AVD を用意すること。
#    例: avdmanager create avd -n store-shots -k "system-images;android-36;google_apis;x86_64"
#        してから ~/.android/avd/store-shots.avd/config.ini の
#        hw.lcd.width=1080 / hw.lcd.height=1920 を設定する。
ANDROID_SCREENSHOT_AVD=""
