# scripts/infra の非機密入力テンプレート。
#   cp scripts/infra/config.example.env scripts/infra/config.env
# として値を埋める（config.env は .gitignore 対象）。
#
# ⚠️ ここには「非機密値」だけを置く。トークン / DB パスワード等の secret は
#    一切書かない（それらは Doppler bootstrap config から `doppler run` で注入される）。
#    詳細は docs/deployment/README.md / .claude/rules/mcp-doppler.md を参照。

# アプリ名（各 PaaS の project 名にそのまま使う。環境 prefix は付けない）。
#   - Supabase: 1 project = production。staging/develop は persistent branch（branch 名 = git branch）。
#   - Vercel / Railway: 1 project + 環境（Preview/Production・environment）で表現。
APP_NAME="myapp"

# 連携する単一 GitHub リポジトリ（owner/repo）。3 PaaS すべてがこの repo を監視する。
GH_REPO="your-org/shadcn-boilerplate"

# 対象環境（branch→env マッピングと一致。並びは固定）
INFRA_ENVS="dev staging production"

# ── Vercel ────────────────────────────────────────────────────────────────
# team(org) に属する場合の team ID（個人アカウントなら空でよい）
VERCEL_TEAM_ID=""
# monorepo の root directory（Next.js web アプリ）
VERCEL_ROOT_DIR="frontend/apps/web"
# production branch（main 固定。vercel.json の git.deploymentEnabled と整合）
VERCEL_PRODUCTION_BRANCH="main"

# ── Supabase ──────────────────────────────────────────────────────────────
# Organization の slug/ID（ダッシュボード or `supabase orgs list` で確認、非機密）
SUPABASE_ORG_ID="your-org-slug"
# 既定リージョン（例: ap-northeast-1）
SUPABASE_REGION="ap-northeast-1"
# インスタンスサイズ（例: micro / small）
SUPABASE_SIZE="micro"

# ── Railway ───────────────────────────────────────────────────────────────
# workspace/team ID（`railway whoami` 等で確認、非機密）。個人なら空でも可。
RAILWAY_WORKSPACE_ID=""

# ── GitHub 本番承認ゲート ───────────────────────────────────────────────────
# production 環境の required reviewers（GitHub ログイン名をカンマ区切り）
GH_PROD_REVIEWERS="your-github-login"

# ── Doppler ───────────────────────────────────────────────────────────────
# Doppler project 名（doppler.yaml の <doppler-project> と一致させる）
DOPPLER_PROJECT="myapp"
